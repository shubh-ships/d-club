# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon public" key. Never the secret/service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Hidden /admin dashboard (server-side only: no VITE_ prefix, never sent to the browser) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-random-password
# Supabase Dashboard → Project Settings → API Keys → "secret" key (sb_secret_...) or legacy "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=
